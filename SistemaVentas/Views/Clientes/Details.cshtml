@model SistemaVentas.Models.Cliente
@{
    ViewData["Title"] = "Detalle cliente";
}

<div class="mb-6">
    <h2 class="font-display text-2xl font-semibold text-slate-900">Detalle del cliente</h2>
</div>

<div class="max-w-2xl rounded-3xl border border-slate-200/80 bg-white p-6 sm:p-8 shadow-panel">
    <div class="flex items-center gap-4 mb-6">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 font-display text-lg font-semibold text-slate-700">
            @(Model.Nombre.Length > 0 ? Model.Nombre[0] : '?')@(Model.Apellido.Length > 0 ? Model.Apellido[0] : '?')
        </div>
        <div>
            <p class="font-display text-xl font-semibold text-slate-900">@Model.NombreCompleto</p>
            <p class="text-sm text-slate-500">@Model.Email</p>
        </div>
    </div>
    <dl class="grid gap-5 sm:grid-cols-2">
        <div>
            <dt class="text-xs uppercase tracking-[0.12em] text-slate-500 font-semibold">Teléfono</dt>
            <dd class="mt-1 text-slate-800">@(Model.Telefono ?? "—")</dd>
        </div>
        <div>
            <dt class="text-xs uppercase tracking-[0.12em] text-slate-500 font-semibold">Email</dt>
            <dd class="mt-1 text-slate-800">@Model.Email</dd>
        </div>
    </dl>
    <div class="mt-8 flex flex-wrap gap-3">
        <a asp-action="Edit" asp-route-id="@Model.ClienteId" class="inline-flex rounded-xl bg-andes-blue px-4 py-2.5 text-sm font-semibold text-white hover:bg-andes-blue/90 transition">Editar</a>
        <a asp-action="Index" class="inline-flex rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">Volver</a>
    </div>
</div>
