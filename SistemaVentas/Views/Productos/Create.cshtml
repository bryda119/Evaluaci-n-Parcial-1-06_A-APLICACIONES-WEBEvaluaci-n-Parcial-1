@model SistemaVentas.Models.Producto
@{
    ViewData["Title"] = "Nuevo producto";
}

<div class="mb-6">
    <h2 class="font-display text-2xl font-semibold text-slate-900">Nuevo producto</h2>
    <p class="text-sm text-slate-500 mt-1">Completa los datos del inventario. Precio y stock solo aceptan números.</p>
</div>

<div class="max-w-2xl rounded-3xl border border-slate-200/80 bg-white p-6 sm:p-8 shadow-panel">
    <form asp-action="Create" class="space-y-5" method="post">
        <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800"></div>
        <div>
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" maxlength="100" placeholder="Ej: Laptop" autocomplete="off" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Descripcion"></label>
            <textarea asp-for="Descripcion" rows="3" maxlength="500" placeholder="Descripción opcional"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
            <div>
                <label asp-for="Precio"></label>
                <input asp-for="Precio" type="number" min="0.01" max="999999.99" step="0.01" inputmode="decimal" data-val-decimal placeholder="0.00" />
                <span asp-validation-for="Precio" class="text-danger"></span>
                <p class="mt-1 text-xs text-slate-500">Solo números decimales (ej: 25.50)</p>
            </div>
            <div>
                <label asp-for="Stock"></label>
                <input asp-for="Stock" type="number" min="0" max="1000000" step="1" inputmode="numeric" data-val-integer placeholder="0" />
                <span asp-validation-for="Stock" class="text-danger"></span>
                <p class="mt-1 text-xs text-slate-500">Solo números enteros (sin decimales)</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-3 pt-2">
            <button type="submit" class="inline-flex rounded-xl bg-andes-blue px-4 py-2.5 text-sm font-semibold text-white hover:bg-andes-blue/90 transition">Guardar</button>
            <a asp-action="Index" class="inline-flex rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
