@model IEnumerable<SistemaVentas.Models.Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h2 class="font-display text-2xl font-semibold text-slate-900">Inventario</h2>
        <p class="text-sm text-slate-500 mt-1">Catálogo de productos y niveles de stock.</p>
    </div>
    <a asp-action="Create" class="inline-flex items-center justify-center rounded-xl bg-andes-blue px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-andes-blue/90 transition">
        Nuevo producto
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">@TempData["Error"]</div>
}

<div class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-panel">
    <div class="overflow-x-auto">
        <table class="table-pro">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="font-semibold text-slate-900">@item.Nombre</td>
                        <td class="text-slate-500 max-w-xs truncate">@item.Descripcion</td>
                        <td class="font-medium tabular-nums">@item.Precio.ToString("C")</td>
                        <td>
                            @if (item.Stock <= 5)
                            {
                                <span class="inline-flex rounded-full bg-andes-gold/15 px-2.5 py-1 text-xs font-semibold text-andes-goldDark ring-1 ring-andes-gold/40">@item.Stock</span>
                            }
                            else
                            {
                                <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">@item.Stock</span>
                            }
                        </td>
                        <td class="text-right whitespace-nowrap">
                            <a asp-action="Details" asp-route-id="@item.ProductoId" class="text-sm font-semibold text-slate-600 hover:text-andes-blue">Ver</a>
                            <span class="text-slate-300 mx-1">|</span>
                            <a asp-action="Edit" asp-route-id="@item.ProductoId" class="text-sm font-semibold text-slate-600 hover:text-andes-blue">Editar</a>
                            <span class="text-slate-300 mx-1">|</span>
                            <a asp-action="Delete" asp-route-id="@item.ProductoId" class="text-sm font-semibold text-rose-600 hover:text-rose-700">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
